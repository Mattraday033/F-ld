:"$r2"}],"\n",{"->":"2c"},{"#f":5}],"c-1":["ev",{"^->":"2b.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":"2b.0.3.s"},[{"#n":"$r2"}],"\n","^setToTrue(insultedKendesCooking)","\n","^You little shit! Get out of here before I decide you're worth caning.","\n",{"->":"Close"},{"#f":5}]}],{"#f":1}],"2c":[["^Oh, um... thanks.","\n",["ev",{"^->":"2c.0.2.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"2c.0.c-0","flg":2},{"s":["^Don't mention it. Good bye.",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"2c.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":"2c.0.2.s"},[{"#n":"$r2"}],"\n",["ev",{"VAR?":"kendeWillSellToPlayer"},"/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"Close"},{"->":".^.^.^.9"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"2d"},{"->":".^.^.^.9"},null]}],"nop","\n",{"#f":5}]}],{"#f":1}],"2d":[["^setToTrue(kendeWillSellToPlayer)","\n","^Wait, you aren't ungrateful like the other slaves. I make a little money on the side selling stuff to the other guards. If you happen to \"find\" any coins lying around out there, I'll give you something for them.","\n",["ev",{"^->":"2d.0.4.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"2d.0.c-0","flg":2},{"s":["^I have some money on me right now.",{"->":"$r","var":true},null]}],["ev",{"^->":"2d.0.5.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"2d.0.c-1","flg":2},{"s":["^That's good to know. I'll come back if anything comes my way.",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"2d.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":"2d.0.4.s"},[{"#n":"$r2"}],"\n",{"->":"shop"},{"#f":5}],"c-1":["ev",{"^->":"2d.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":"2d.0.5.s"},[{"#n":"$r2"}],"\n",{"->":"Close"},{"#f":5}]}],{"#f":1}],"3aa":["^fadeToBlack(false, false)","\n","^setToTrue(toldKendeTaborSentForMeal)","\n","^activateQuestStep(A Situation Brews,Assess the situation.)","\n","ev",true,"/ev",{"VAR=":"weftActive","re":true},"^activate(","ev",{"VAR?":"weftIndex"},"out","/ev","^)","\n","^fadeBackIn(60)","\n","^enableDialogueUI()","\n",["ev",{"VAR?":"insultedKendesCooking"},"/ev",{"->":".^.b","c":true},{"b":["\n","^Another showing from my least favorite branded. Back to give me more grief I suppose?","\n",{"->":"3a"},{"->":"3aa.24"},null]}],["ev",{"VAR?":"gotMessHallInstructionsFromKende"},"/ev",{"->":".^.b","c":true},{"b":["\n","^You're back. If you're here for another helping, you're in for disappointment. You were lucky you got the first, the workers who are stuck in their huts only get fed at sunup and sundown.","\n",{"->":"3a"},{"->":"3aa.24"},null]}],[{"->":".^.b"},{"b":["\n","ev",{"^->":"3a"},"/ev",{"->":"1a"},{"->":"3aa.24"},null]}],"nop","\n",{"#f":1}],"3a":["^And I see Weft is with you. Has our mutual friend sent you back to me?","\n","^changeCamTarget(","ev",{"VAR?":"weftIndex"},"out","/ev","^)","\n","^I'm on a work detail with my new hutmate here. Chief Tabor has us on break for our midday meal.","\n","^changeCamTarget(","ev",{"VAR?":"kendeIndex"},"out","/ev","^)","\n","^prepForItem()","\n","^In that case, here is your helping.","\n","^giveItem(0,0,1)","\n",["ev",{"VAR?":"insultedKendesCooking"},"/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"3b"},{"->":"3a.25"},null]}],"nop","\n","^combineDialogue()","\n","^*Kende turns back to you.* If you're a friend of Weft's then you must be the trustworthy sort. You know,","\n",{"->":"3ab"},{"#f":3}],"3ab":[["^I make a tidy bit of money selling hard-to-get goods that come in on the supply wagons. If you <i>find</i> any gold while working in the camp, I'd be happy to give you something for it.","\n",["ev",{"^->":"3ab.0.2.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^I'll see what you have.",{"->":"$r","var":true},null]}],["ev",{"^->":"3ab.0.3.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-1","flg":2},{"s":["^Maybe later.",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"3ab.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.2.s"},[{"#n":"$r2"}],"\n",{"->":"shop"},{"#f":5}],"c-1":["ev",{"^->":"3ab.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.3.s"},[{"#n":"$r2"}],"\n","^*Kende shrugs.* Suit yourself.","\n",{"->":"Close"},{"#f":5}]}],{"#f":1}],"3b":[["^You know Weft, you keep ill company. This one hasn't been here a day and they've already insulted me to my face.","\n","^changeCamTarget(","ev",{"VAR?":"weftIndex"},"out","/ev","^)","\n","^*Weft frowns.* They certainly seem to get around.","\n","^changeCamTarget(","ev",{"VAR?":"kendeIndex"},"out","/ev","^)","\n","^You and I have made quite a bit of money during your time here. I'd have happily extended the same deal to them, if they were the trustworthy sort.","\n",["ev",true,"/ev",{"->":".^.b","c":true},{"b":["\n",["ev",{"^->":"3b.0.20.b.1.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^I was just having a bit of fun before, nothing was meant by it. What's a little ribbing between friends? <Cha ","ev",{"VAR?":"charisma"},"out","/ev","^/2>",{"->":"$r","var":true},null]}],{"->":"3b.0.21"},{"c-0":["ev",{"^->":"3b.0.20.b.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n",["ev",{"VAR?":"charisma"},2,">=","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"3ba"},{"->":".^.^.^.9"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"3d"},{"->":".^.^.^.9"},null]}],"nop","\n",{"#f":5}]}]}],"nop","\n",["ev",{"VAR?":"weftKnowsYouKnowHisSecret"},"/ev",{"->":".^.b","c":true},{"b":["\n",["ev",{"^->":"3b.0.23.b.1.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":".^.^.c-0","flg":2},{"s":["^Weft owes me a great deal already. *Glare at Weft.* You'll vouch for me, <i>won't</i> you?",{"->":"$r","var":true},null]}],{"->":"3b.0.24"},{"c-0":["ev",{"^->":"3b.0.23.b.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":".^.^.1.s"},[{"#n":"$r2"}],"\n",{"->":"3e"},{"#f":5}]}]}],"nop","\n",["ev",{"^->":"3b.0.26.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"3b.0.c-0","flg":2},{"s":["^I didn't realize you were a businessman. Would an apology allow you to put profit before pride?",{"->":"$r","var":true},null]}],["ev",{"^->":"3b.0.27.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"3b.0.c-1","flg":2},{"s":["^Whatever this deal is, I want no part of it.",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"3b.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":"3b.0.26.s"},[{"#n":"$r2"}],"\n",{"->":"3c"},{"#f":5}],"c-1":["ev",{"^->":"3b.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":"3b.0.27.s"},[{"#n":"$r2"}],"\n","^That is good, because I'm glad to be rid of you. Leave me.","\n",{"->":"Close"},{"#f":5}]}],{"#f":1}],"3ba":["^combineDialogue()","\n","^*Kende chews his lip in thought.* Very well, let's put such small words behind us then.","\n",{"->":"3ab"},{"#f":1}],"3c":[["^I suppose I could be convinced, if it were heartfelt enough.","\n",["ev",{"^->":"3c.0.2.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"3c.0.c-0","flg":2},{"s":["^Then allow me to apologize. What I said was uncalled for, and untrue.",{"->":"$r","var":true},null]}],["ev",{"^->":"3c.0.3.$r1"},{"temp=":"$r"},"str",{"->":".^.s"},[{"#n":"$r1"}],"/str","/ev",{"*":"3c.0.c-1","flg":2},{"s":["^Well, my heart just isn't in it. Get bent. ",{"->":"$r","var":true},null]}],{"c-0":["ev",{"^->":"3c.0.c-0.$r2"},"/ev",{"temp=":"$r"},{"->":"3c.0.2.s"},[{"#n":"$r2"}],"\n","^combineDialogue()","\n","^Well said.","\n",{"->":"3ab"},{"#f":5}],"c-1":["ev",{"^->":"3c.0.c-1.$r2"},"/ev",{"temp=":"$r"},{"->":"3c.0.3.s"},[{"#n":"$r2"}],"\n","^Gah! Begone from here! You won't get another ration from me so long as you live!","\n",{"->":"Close"},{"#f":5}]}],{"#f":1}],"3d":["^Us, friends? The thought revolts me, scum. Get gone.","\n",{"->":"Close"},{"#f":1}],"3e":["^changeCamTarget(","ev",{"VAR?":"weftIndex"},"out","/ev","^)","\n","^*Weft's frown deepens.* We've worked together all day and I can already tell they are very... profit minded. I think bringing the